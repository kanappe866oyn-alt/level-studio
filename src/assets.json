  "MODE_CONFIG": {
    "free": {
      "label": "🎨 自由制作",
      "description": "ルール制限なし。全Roleを使用して思いついた空間を自由に作るモード。",
      "roles": ["landform", "terrain", "ground", "platform", "slope", "cliff", "pit", "wall", "room", "corridor", "door", "window", "boundary", "cover", "tower", "path", "climb", "bridge", "spawn", "checkpoint", "goal", "exit", "objective", "trap", "hazard", "switch", "key", "barrier", "moving_platform", "fragile", "water", "lava", "tree", "rock", "plant", "vehicle", "ball", "paper", "light", "landmark", "bounce", "building", "prop"],
      "requiredRoles": ["ground"],
      "minCounts": {}
    },
    "combat": {
      "label": "🔫 対戦アリーナ (Combat)",
      "description": "遮蔽物で射線を切り、高所を取り合う撃ち合いの面白さを作るモード。",
      "roles": ["landform", "ground", "platform", "wall", "room", "corridor", "boundary", "cover", "tower", "climb", "bridge", "spawn", "door", "window", "vehicle", "rock", "building", "prop"],
      "requiredRoles": ["ground", "cover", "tower", "spawn"],
      "minCounts": { "cover": 4, "tower": 1, "spawn": 2 }
    },
    "platforming": {
      "label": "🧗 立体アスレチック (Platforming)",
      "description": "足場を登り継ぎ、穴を跨いでゴールを目指す、高さと移動の面白さを作るモード。",
      "roles": ["landform", "terrain", "ground", "platform", "slope", "cliff", "pit", "climb", "bridge", "spawn", "checkpoint", "goal", "moving_platform", "water", "lava", "bounce"],
      "requiredRoles": ["ground", "platform", "climb", "spawn", "goal"],
      "minCounts": { "platform": 2, "climb": 1, "spawn": 1, "goal": 1 }
    }
  },
  "MODE_GUIDELINES": {
    "combat": {
      "do": [
        "spawn は対角線上の最も遠い2箇所に配置し、開始直後に射線が通らないようにする",
        "tower は全体を見渡せる位置に配置する",
        "cover は交戦が起きる中央付近に分散して配置する"
      ],
      "dont": ["spawn 地点から相手の spawn 地点が直接見えるようにしない"]
    },
    "platforming": {
      "do": [
        "spawn から goal まで、climb(階段等) を使って platform(高所の足場) を登り継ぐルートを作る",
        "pit や lava(危険な床) がある場合は、それを跨ぐように bridge を架ける"
      ],
      "dont": ["climb が繋がっていない孤立した platform を作らない"]
    }
  }
